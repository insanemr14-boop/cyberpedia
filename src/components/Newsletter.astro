---
/**
 * Newsletter capture.
 *
 * Posts to the endpoint configured in `site.config.ts`. The form is a real
 * <form> with a real action, so it degrades gracefully; the progressive
 * enhancement below intercepts the submit for inline feedback when JS runs.
 *
 * `/api/newsletter` is a documented placeholder — see `src/pages/api/README.md`
 * for wiring it to a provider or a Cloudflare Pages Function.
 */
import { SITE } from '../config/site.config';

interface Props {
  variant?: 'banner' | 'inline';
  class?: string;
}

const { variant = 'inline', class: className = '' } = Astro.props;
const isBanner = variant === 'banner';
const { heading, body, buttonLabel, endpoint } = SITE.newsletter;
---

<section
  class:list={[
    isBanner
      ? 'flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between'
      : 'surface p-5 sm:p-6',
    className,
  ]}
  aria-labelledby={`newsletter-heading-${variant}`}
>
  <div class={isBanner ? 'max-w-xl' : ''}>
    <h2
      id={`newsletter-heading-${variant}`}
      class:list={[
        'font-extrabold tracking-tight text-[var(--text)]',
        isBanner ? 'text-xl sm:text-2xl' : 'text-base',
      ]}
    >
      {heading}
    </h2>
    <p
      class:list={[
        'mt-2 leading-relaxed text-[var(--text-muted)]',
        isBanner ? 'text-sm sm:text-base' : 'text-sm',
      ]}
    >
      {body}
    </p>
  </div>

  <form
    class={isBanner ? 'w-full max-w-md shrink-0' : 'mt-4'}
    action={endpoint}
    method="post"
    data-newsletter
  >
    <div class="flex flex-col gap-2 sm:flex-row">
      <label class="sr-only" for={`newsletter-email-${variant}`}>Email address</label>
      <input
        id={`newsletter-email-${variant}`}
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@company.com"
        class="min-w-0 flex-1 rounded-lg border border-[var(--border)] bg-[var(--bg)]
               px-3.5 py-2.5 text-sm text-[var(--text)]
               placeholder:text-[var(--text-subtle)] transition-colors
               focus:border-[var(--brand)] focus:outline-none"
      />
      <button
        type="submit"
        class="shrink-0 rounded-lg bg-[var(--color-primary)] px-5 py-2.5 text-sm
               font-semibold text-white transition-colors
               hover:bg-[var(--color-primary-hover)]
               disabled:cursor-not-allowed disabled:opacity-60"
      >
        {buttonLabel}
      </button>
    </div>

    {/* Honeypot: bots fill this, humans never see it. */}
    <div class="absolute left-[-9999px]" aria-hidden="true">
      <label>
        Leave this empty
        <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <p
      data-newsletter-status
      role="status"
      aria-live="polite"
      class="mt-2 min-h-5 text-xs text-[var(--text-subtle)]"
    >
      No spam. Unsubscribe in one click.
    </p>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-newsletter-status]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      // Honeypot tripped — pretend success, do nothing.
      if (data.get('company_website')) return;

      button && (button.disabled = true);
      status && (status.textContent = 'Subscribing…');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });

        if (!response.ok) throw new Error(String(response.status));

        form.reset();
        status && (status.textContent = 'Subscribed. Check your inbox to confirm.');
      } catch {
        status &&
          (status.textContent =
            'Could not subscribe right now. Please try again shortly.');
      } finally {
        button && (button.disabled = false);
      }
    });
  });
</script>
