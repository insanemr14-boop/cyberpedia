---
import { SITE, FOOTER_NAV } from '../config/site.config';
import { CATEGORIES } from '../config/categories';
import Newsletter from './Newsletter.astro';

const year = new Date().getFullYear();
// Surface the highest-value categories in the footer for internal link equity.
const footerCategories = CATEGORIES.slice(0, 10);
---

{SITE.features.newsletter && (
  <section class="border-t border-[var(--border)] bg-[var(--bg-alt)]">
    <div class="container-page py-14">
      <Newsletter variant="banner" />
    </div>
  </section>
)}

<footer class="border-t border-[var(--border)] bg-[var(--bg)]">
  <div class="container-page py-12">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-5">
      {/* ---------- Brand column ---------- */}
      <div class="lg:col-span-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-lg font-extrabold tracking-tight"
        >
          <svg class="size-7" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="var(--color-primary)" />
            <path
              d="M16 7l7 3v6c0 4.2-2.9 7.6-7 8.4-4.1-.8-7-4.2-7-8.4v-6l7-3Z"
              fill="none"
              stroke="#fff"
              stroke-width="2"
              stroke-linejoin="round"
            />
            <path
              d="m12.8 16.2 2.3 2.3 4.3-4.6"
              fill="none"
              stroke="#fff"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>
            <span class="text-[var(--text)]">{SITE.logo.primary}</span><span
              class="text-[var(--color-primary)]">{SITE.logo.accent}</span
            >
          </span>
        </a>

        <p class="mt-4 max-w-sm text-sm leading-relaxed text-[var(--text-muted)]">
          {SITE.description}
        </p>

        <div class="mt-5 flex items-center gap-3">
          {SITE.social.linkedin && (
            <a
              href={SITE.social.linkedin}
              rel="me noopener noreferrer"
              target="_blank"
              class="grid size-9 place-items-center rounded-lg border border-[var(--border)]
                     text-[var(--text-muted)] transition-colors hover:text-[var(--color-primary)]"
              aria-label={`${SITE.name} on LinkedIn`}
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21h-4v-5.6c0-1.34-.03-3.07-1.9-3.07-1.9 0-2.2 1.46-2.2 2.97V21h-4z" />
              </svg>
            </a>
          )}
          {SITE.social.instagram && (
            <a
              href={SITE.social.instagram}
              rel="me noopener noreferrer"
              target="_blank"
              class="grid size-9 place-items-center rounded-lg border border-[var(--border)]
                     text-[var(--text-muted)] transition-colors hover:text-[var(--color-primary)]"
              aria-label={`${SITE.name} on Instagram`}
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2c2.7 0 3.06.01 4.12.06 1.06.05 1.79.22 2.42.46.66.26 1.22.6 1.77 1.16.56.55.9 1.11 1.16 1.77.24.63.41 1.36.46 2.42C21.99 8.94 22 9.3 22 12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.46 2.42a4.9 4.9 0 0 1-1.16 1.77c-.55.56-1.11.9-1.77 1.16-.63.24-1.36.41-2.42.46-1.06.05-1.42.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.42-.46a4.9 4.9 0 0 1-1.77-1.16 4.9 4.9 0 0 1-1.16-1.77c-.24-.63-.41-1.36-.46-2.42C2.01 15.06 2 14.7 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.46-2.42.26-.66.6-1.22 1.16-1.77.55-.56 1.11-.9 1.77-1.16.63-.24 1.36-.41 2.42-.46C8.94 2.01 9.3 2 12 2Zm0 1.8c-2.65 0-2.96.01-4.01.06-.97.04-1.5.2-1.85.34-.46.18-.8.4-1.15.75-.35.35-.57.69-.75 1.15-.14.35-.3.88-.34 1.85-.05 1.05-.06 1.36-.06 4.01s.01 2.96.06 4.01c.04.97.2 1.5.34 1.85.18.46.4.8.75 1.15.35.35.69.57 1.15.75.35.14.88.3 1.85.34 1.05.05 1.36.06 4.01.06s2.96-.01 4.01-.06c.97-.04 1.5-.2 1.85-.34.46-.18.8-.4 1.15-.75.35-.35.57-.69.75-1.15.14-.35.3-.88.34-1.85.05-1.05.06-1.36.06-4.01s-.01-2.96-.06-4.01c-.04-.97-.2-1.5-.34-1.85a3.1 3.1 0 0 0-.75-1.15 3.1 3.1 0 0 0-1.15-.75c-.35-.14-.88-.3-1.85-.34-1.05-.05-1.36-.06-4.01-.06Zm0 3.07a5.13 5.13 0 1 1 0 10.26 5.13 5.13 0 0 1 0-10.26Zm0 1.8a3.33 3.33 0 1 0 0 6.66 3.33 3.33 0 0 0 0-6.66Zm5.34-3.2a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z" />
              </svg>
            </a>
          )}
          {SITE.social.whatsapp && (
            <a
              href={SITE.social.whatsapp}
              rel="noopener noreferrer"
              target="_blank"
              class="grid size-9 place-items-center rounded-lg border border-[var(--border)]
                     text-[var(--text-muted)] transition-colors hover:text-[var(--color-primary)]"
              aria-label="Contact us on WhatsApp"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 1 1-4.2 15.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 0 1 12 3.8Zm5.3 12.2c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-1.6-.1a12 12 0 0 1-5-4.3c-.4-.6-.9-1.4-.9-2.2s.4-1.2.6-1.4a.7.7 0 0 1 .5-.2h.4c.2 0 .3 0 .5.4l.7 1.6c0 .2 0 .3-.1.5l-.3.4-.2.2c-.1.2-.2.3 0 .5a8 8 0 0 0 3.4 2.9c.3.1.4.1.6-.1l.7-.9c.2-.2.3-.2.5-.1l1.6.8c.2.1.4.2.4.3v.6Z" />
              </svg>
            </a>
          )}
          <a
            href="/rss.xml"
            class="grid size-9 place-items-center rounded-lg border border-[var(--border)]
                   text-[var(--text-muted)] transition-colors hover:text-[var(--color-primary)]"
            aria-label="RSS feed"
          >
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <circle cx="6.2" cy="17.8" r="2.2" />
              <path d="M4 10.2v2.9a7.9 7.9 0 0 1 6.9 6.9h2.9C13.8 14.9 9.3 10.4 4 10.2Zm0-5.2v2.9c6.2.2 11.2 5.2 11.4 11.4h2.9C18.1 11.4 12 5.2 4 5Z" />
            </svg>
          </a>
        </div>

        <address class="mt-5 text-sm not-italic leading-relaxed text-[var(--text-subtle)]">
          <a
            href={`mailto:${SITE.organization.email}`}
            class="block transition-colors hover:text-[var(--color-primary)]"
          >
            {SITE.organization.email}
          </a>
          <a
            href={`tel:+${SITE.organization.phoneE164}`}
            class="block transition-colors hover:text-[var(--color-primary)]"
          >
            {SITE.organization.phone}
          </a>
          <span class="block">
            {SITE.organization.address.locality}, {SITE.organization.address.country}
          </span>
        </address>
      </div>

      {/* ---------- Link columns ---------- */}
      {
        FOOTER_NAV.map((group) => (
          <nav aria-labelledby={`footer-${group.heading}`}>
            <h2
              id={`footer-${group.heading}`}
              class="text-xs font-bold uppercase tracking-wider text-[var(--text)]"
            >
              {group.heading}
            </h2>
            <ul class="mt-4 space-y-2.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-[var(--text-muted)] transition-colors hover:text-[var(--color-primary)]"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    {/* ---------- Category link cloud (internal linking) ---------- */}
    <div class="mt-10 border-t border-[var(--border)] pt-8">
      <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text)]">
        Browse Topics
      </h2>
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
        {
          footerCategories.map((cat) => (
            <li>
              <a
                href={`/category/${cat.slug}/`}
                class="text-sm text-[var(--text-muted)] transition-colors hover:text-[var(--color-primary)]"
              >
                {cat.name}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/categories"
            class="text-sm font-semibold text-[var(--color-primary)] transition-colors hover:underline"
          >
            All categories &rarr;
          </a>
        </li>
      </ul>
    </div>

    {/* ---------- Legal bar ---------- */}
    <div
      class="mt-8 flex flex-col gap-3 border-t border-[var(--border)] pt-6
             text-sm text-[var(--text-subtle)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.organization.legalName}. All rights reserved.</p>
      <p>
        Published for defensive and educational purposes.
        <a href="/disclaimer" class="link-underline ml-1 text-[var(--text-muted)]">
          Disclaimer
        </a>
      </p>
    </div>
  </div>
</footer>
