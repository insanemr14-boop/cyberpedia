---
/**
 * Contact / lead form.
 *
 * Posts natively (no fetch, no JS) to the shared RioCloud lead worker, which
 * relays to info@riocloudsolutions.com over SMTP. A native form POST is not
 * subject to CORS, so this works unchanged on a fully static host.
 *
 * `redirect` sends the visitor back to our own thank-you page instead of the
 * worker's, so the flow never leaves the brand. `website` is a honeypot: bots
 * fill it, the worker then silently discards the submission.
 */
import { SITE } from '../config/site.config';

interface Props {
  /** Prefills the subject line so different pages can tag their leads. */
  subject?: string;
  class?: string;
}

const { subject = '', class: className = '' } = Astro.props;

const ENDPOINT = 'https://dentistseo.dpdns.org/api/lead';

const field =
  'mt-1 w-full rounded-[var(--radius-card)] border border-[var(--border)] bg-[var(--bg)] ' +
  'px-3 py-2 text-[var(--text)] outline-none focus:border-[var(--color-primary)] ' +
  'focus:ring-2 focus:ring-[var(--color-primary)]/30';
const label = 'block text-sm font-semibold text-[var(--text)]';
---

<form method="POST" action={ENDPOINT} class={`not-prose ${className}`}>
  <input type="hidden" name="site" value={SITE.url} />
  <input type="hidden" name="redirect" value={`${SITE.url}/thank-you/`} />

  {/* Honeypot — hidden from people, irresistible to bots. */}
  <div class="absolute left-[-9999px]" aria-hidden="true">
    <label>Leave this field empty<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class={label} for="lf-name">Your name</label>
      <input class={field} id="lf-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div>
      <label class={label} for="lf-email">Email</label>
      <input class={field} id="lf-email" name="email" type="email" required autocomplete="email" />
    </div>
  </div>

  <div class="mt-4">
    <label class={label} for="lf-subject">Subject</label>
    <input class={field} id="lf-subject" name="subject" type="text" value={subject} required />
  </div>

  <div class="mt-4">
    <label class={label} for="lf-message">How can we help?</label>
    <textarea class={field} id="lf-message" name="message" rows="5" required></textarea>
  </div>

  <button
    type="submit"
    class="mt-5 inline-flex items-center justify-center rounded-[var(--radius-card)] bg-[var(--color-primary)] px-5 py-2.5 font-semibold text-[#fff] transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/40"
  >
    Send message
  </button>

  <p class="mt-3 text-sm text-[var(--text-muted)]">
    We reply to every genuine enquiry. Your details go only to our team — never sold, never
    added to a marketing list. See the <a href="/privacy-policy/">privacy policy</a>.
  </p>
</form>
