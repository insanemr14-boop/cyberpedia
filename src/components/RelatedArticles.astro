---
import type { Article } from '../lib/articles';
import ArticleCard from './ArticleCard.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  articles: Article[];
  title?: string;
  class?: string;
}

const { articles, title = 'Related Articles', class: className = '' } = Astro.props;
---

{
  articles.length > 0 && (
    <section class={className} aria-label={title}>
      <SectionHeading title={title} as="h2" />
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {articles.map((article) => (
          <ArticleCard article={article} variant="default" headingLevel={3} />
        ))}
      </div>
    </section>
  )
}
