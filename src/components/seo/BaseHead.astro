---
/**
 * Every <head> tag the site emits, in one place.
 * No page should ever write its own meta tags.
 */
import { SITE } from '../../config/site.config';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative image path for OG/Twitter cards. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  keywords?: string[];
  publishedTime?: Date;
  modifiedTime?: Date;
  authorName?: string;
  section?: string;
  /** Set on paginated and filtered surfaces that should not be indexed. */
  noindex?: boolean;
  /** Overrides the derived canonical (used by paginated archives). */
  canonicalOverride?: string;
  prev?: string;
  next?: string;
}

const {
  title,
  description,
  image = '/og-default.png',
  imageAlt = SITE.name,
  type = 'website',
  keywords = [],
  publishedTime,
  modifiedTime,
  authorName,
  section,
  noindex = false,
  canonicalOverride,
  prev,
  next,
} = Astro.props;

// Canonicals are built from the pathname, never from the request URL, so query
// strings and trailing-slash variants can never fragment the canonical.
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = canonicalOverride
  ? new URL(canonicalOverride, SITE.url).toString()
  : new URL(pathname === '/' ? '/' : `${pathname}/`, SITE.url).toString();

const ogImage = new URL(image, SITE.url).toString();
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const metaKeywords = keywords.length ? keywords.join(', ') : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
{metaKeywords && <meta name="keywords" content={metaKeywords} />}
<link rel="canonical" href={canonical} />

{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  )
}

{prev && <link rel="prev" href={new URL(prev, SITE.url).toString()} />}
{next && <link rel="next" href={new URL(next, SITE.url).toString()} />}

{/* ---------- Icons & manifest ---------- */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />

{/* ---------- Feeds ---------- */}
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} RSS Feed`}
  href={new URL('/rss.xml', SITE.url).toString()}
/>
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

{/* ---------- Open Graph ---------- */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={SITE.locale} />

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{type === 'article' && authorName && (
  <meta property="article:author" content={authorName} />
)}
{type === 'article' && section && (
  <meta property="article:section" content={section} />
)}
{type === 'article' &&
  keywords.map((tag) => <meta property="article:tag" content={tag} />)}

{/* ---------- Twitter ---------- */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />
{SITE.social.twitterHandle && (
  <meta name="twitter:site" content={SITE.social.twitterHandle} />
)}
{SITE.social.twitterHandle && (
  <meta name="twitter:creator" content={SITE.social.twitterHandle} />
)}

{/* ---------- Search Console ---------- */}
{SITE.analytics.googleSearchConsoleVerification && (
  <meta
    name="google-site-verification"
    content={SITE.analytics.googleSearchConsoleVerification}
  />
)}

{/* ---------- Fonts ----------
    Preconnect before the stylesheet so the TLS handshake overlaps HTML parse.
    Only the weights actually used are requested, and `display=swap` prevents
    invisible text while the font loads. */}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
/>

{/* Theme is applied by a render-blocking external script (no inline script,
    so a strict CSP stays possible) before first paint. */}
<script is:inline src="/theme-init.js"></script>
