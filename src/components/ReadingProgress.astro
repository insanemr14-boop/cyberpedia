---
/**
 * Reading progress indicator.
 *
 * Animates `transform: scaleX` only — never width — so it stays on the
 * compositor and cannot trigger layout during scroll. Updates are throttled to
 * one per animation frame.
 */
---

<div
  class="reading-progress"
  data-reading-progress
  role="progressbar"
  aria-label="Reading progress"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
></div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
  const article = document.querySelector<HTMLElement>('[data-article-body]');

  if (bar && article) {
    let ticking = false;

    function update() {
      ticking = false;
      if (!bar || !article) return;

      const start = article.offsetTop;
      const readable = article.offsetHeight - window.innerHeight;
      const scrolled = window.scrollY - start;

      const ratio = readable <= 0 ? 1 : Math.min(1, Math.max(0, scrolled / readable));

      bar.style.transform = `scaleX(${ratio})`;
      bar.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
