---
import type { Category } from '../config/categories';

interface Props {
  category: Category;
  count?: number;
}

const { category, count } = Astro.props;
---

<a
  href={`/category/${category.slug}/`}
  class="surface group relative flex flex-col gap-3 overflow-hidden p-5 transition-all
         duration-200 hover:-translate-y-0.5 hover:border-[var(--border-strong)]
         hover:shadow-lg hover:shadow-black/5"
  style={`--cat:${category.accent}`}
>
  {/* Accent wash that intensifies on hover */}
  <span
    class="pointer-events-none absolute inset-x-0 top-0 h-24 opacity-[0.07]
           transition-opacity duration-200 group-hover:opacity-[0.16]"
    style="background: radial-gradient(120% 100% at 0% 0%, var(--cat), transparent 70%)"
    aria-hidden="true"></span>

  <span
    class="grid size-11 shrink-0 place-items-center rounded-xl border
           border-[color-mix(in_srgb,var(--cat)_30%,transparent)]
           bg-[color-mix(in_srgb,var(--cat)_12%,transparent)]"
    aria-hidden="true"
  >
    <svg
      class="size-[22px]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="var(--cat)"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d={category.icon}></path>
    </svg>
  </span>

  <div class="relative">
    <h3
      class="text-base font-bold tracking-tight text-[var(--text)]
             transition-colors group-hover:text-[var(--color-primary)]"
    >
      {category.name}
    </h3>
    <p class="clamp-2 mt-1.5 text-sm leading-relaxed text-[var(--text-muted)]">
      {category.description}
    </p>
  </div>

  {
    count !== undefined && (
      <span class="relative mt-auto text-xs font-semibold text-[var(--text-subtle)]">
        {count} {count === 1 ? 'article' : 'articles'}
      </span>
    )
  }
</a>
