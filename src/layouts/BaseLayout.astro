---
/**
 * The document shell. Every page renders through this.
 */
import '../styles/global.css';
import BaseHead from '../components/seo/BaseHead.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Analytics from '../components/Analytics.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site.config';
import { graph, organizationSchema, websiteSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  keywords?: string[];
  publishedTime?: Date;
  modifiedTime?: Date;
  authorName?: string;
  section?: string;
  noindex?: boolean;
  canonicalOverride?: string;
  prev?: string;
  next?: string;
  /** Extra JSON-LD nodes merged into the site-wide @graph. */
  schemaNodes?: object[];
  bodyClass?: string;
}

const { schemaNodes = [], bodyClass = '', ...head } = Astro.props;

// Organization and WebSite appear on every page so the entity graph is
// reinforced site-wide rather than only on the home page.
const jsonLd = graph(organizationSchema(), websiteSchema(), ...schemaNodes);
---

<!doctype html>
<html lang={SITE.language} class="scroll-smooth">
  <head>
    <BaseHead {...head} />
    <JsonLd schema={jsonLd} />
    <Analytics />
  </head>

  <body class={`flex min-h-screen flex-col ${bodyClass}`}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:left-4 focus:top-4 focus:z-[100]
             focus:rounded-lg focus:bg-[var(--color-primary)] focus:font-semibold
             focus:text-white"
    >
      Skip to main content
    </a>

    <Navbar />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
