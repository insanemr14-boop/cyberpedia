---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro';
import { getPublishedArticles, getAllTags, type Article } from '../../../lib/articles';
import { SITE } from '../../../config/site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const [articles, tags] = await Promise.all([getPublishedArticles(), getAllTags()]);

  return tags.flatMap(({ tag }) => {
    const tagged = articles.filter((a) => a.data.tags.includes(tag));
    return paginate(tagged, {
      params: { tag },
      props: { tag },
      pageSize: SITE.pagination.articlesPerPage,
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Article>;
  tag: string;
}

const { page, tag } = Astro.props;
const label = tag.replace(/-/g, ' ');
---

<ArchiveLayout
  title={`#${tag}`}
  eyebrow="Tag"
  description={`Articles tagged ${label} on ${SITE.name} — analysis, guides and reviews covering ${label}.`}
  lede={`Every article tagged ${label}.`}
  articles={page.data}
  currentPage={page.currentPage}
  lastPage={page.lastPage}
  paginationBase={`/tag/${tag}`}
  crumbs={[
    { name: 'Home', href: '/' },
    { name: 'Articles', href: '/articles/' },
    { name: `#${tag}`, href: `/tag/${tag}/` },
  ]}
/>
