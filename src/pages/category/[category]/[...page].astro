---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro';
import { CATEGORIES, type Category } from '../../../config/categories';
import { getPublishedArticles, type Article } from '../../../lib/articles';
import { SITE } from '../../../config/site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getPublishedArticles();

  return CATEGORIES.flatMap((category) => {
    const inCategory = articles.filter((a) => a.data.category === category.slug);
    return paginate(inCategory, {
      params: { category: category.slug },
      props: { category },
      pageSize: SITE.pagination.categoryPerPage,
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Article>;
  category: Category;
}

const { page, category } = Astro.props;
---

<ArchiveLayout
  title={category.name}
  eyebrow={category.group}
  accent={category.accent}
  description={category.description}
  articles={page.data}
  currentPage={page.currentPage}
  lastPage={page.lastPage}
  paginationBase={`/category/${category.slug}`}
  emptyMessage={`No ${category.name} articles have been published yet. This topic is on the editorial roadmap.`}
  crumbs={[
    { name: 'Home', href: '/' },
    { name: 'Categories', href: '/categories/' },
    { name: category.name, href: `/category/${category.slug}/` },
  ]}
/>
