---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { getArticlesByType, type Article } from '../../lib/articles';
import { SITE, CONTENT_TYPES } from '../../config/site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getArticlesByType('guide');
  return paginate(articles, { pageSize: SITE.pagination.articlesPerPage });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Article>;
}

const { page } = Astro.props;
---

<ArchiveLayout
  title={CONTENT_TYPES.guide.plural}
  eyebrow="Guides"
  description={CONTENT_TYPES.guide.description}
  lede="Implementation walkthroughs written for practitioners — hardening, detection, architecture and pipeline controls."
  articles={page.data}
  currentPage={page.currentPage}
  lastPage={page.lastPage}
  paginationBase="/guides"
  emptyMessage="No guides have been published yet."
  crumbs={[
    { name: 'Home', href: '/' },
    { name: 'Guides', href: '/guides/' },
  ]}
/>
