---
import type { GetStaticPaths, Page } from 'astro';
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';
import { getArticlesByType, type Article } from '../../lib/articles';
import { SITE, CONTENT_TYPES } from '../../config/site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getArticlesByType('news');
  return paginate(articles, { pageSize: SITE.pagination.articlesPerPage });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Article>;
}

const { page } = Astro.props;
---

<ArchiveLayout
  title={CONTENT_TYPES.news.plural}
  eyebrow="News"
  description={CONTENT_TYPES.news.description}
  lede="Vulnerability disclosures, incident reporting and emerging threat coverage as it develops."
  articles={page.data}
  currentPage={page.currentPage}
  lastPage={page.lastPage}
  paginationBase="/news"
  emptyMessage="No news articles have been published yet."
  crumbs={[
    { name: 'Home', href: '/' },
    { name: 'News', href: '/news/' },
  ]}
/>
