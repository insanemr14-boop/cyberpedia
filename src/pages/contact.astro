---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE } from '../config/site.config';
import { breadcrumbSchema, webPageSchema } from '../lib/schema';

const org = SITE.organization;
const title = 'Contact';
const description = `Get in touch with the ${SITE.name} editorial desk — corrections, story tips, security disclosures, partnerships and general enquiries.`;

const path = '/contact';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];

const channels = [
  {
    label: 'Email',
    value: org.email,
    href: `mailto:${org.email}`,
    note: 'Best for detailed enquiries, corrections and disclosures',
    icon: 'M3 6h18v12H3zM3 7l9 6 9-6',
  },
  {
    label: 'Phone',
    value: org.phone,
    href: `tel:+${org.phoneE164}`,
    note: org.hours,
    icon: 'M4 4h4l2 5-2.5 1.5a12 12 0 0 0 6 6L15 14l5 2v4a1 1 0 0 1-1 1A17 17 0 0 1 3 5a1 1 0 0 1 1-1Z',
  },
  {
    label: 'WhatsApp',
    value: org.phone,
    href: SITE.social.whatsapp,
    note: 'Fastest response for urgent matters',
    icon: 'M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.3 14c-.2.6-1.2 1.2-1.7 1.2-.5.1-1 .1-1.6-.1a12 12 0 0 1-5-4.3c-.4-.6-.9-1.4-.9-2.2s.4-1.2.6-1.4a.7.7 0 0 1 .5-.2h.4c.2 0 .3 0 .5.4l.7 1.6c0 .2 0 .3-.1.5l-.3.4-.2.2c-.1.2-.2.3 0 .5a8 8 0 0 0 3.4 2.9c.3.1.4.1.6-.1l.7-.9c.2-.2.3-.2.5-.1l1.6.8c.2.1.4.2.4.3v.6Z',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  schemaNodes={[
    webPageSchema({ path, title, description, breadcrumbPath: path }),
    breadcrumbSchema(path, crumbs),
  ]}
>
  <div class="container-page py-10 sm:py-14">
    <Breadcrumb items={crumbs} class="mb-6" />

    <header class="max-w-3xl">
      <h1
        class="text-3xl font-extrabold leading-tight tracking-tight text-[var(--text)] sm:text-4xl"
      >
        Contact
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-[var(--text-muted)]">
        Corrections, tips, disclosures and partnerships — here is how to reach the right
        desk. {org.responseTime}.
      </p>
    </header>

    {/* ---------- Contact channels ---------- */}
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        channels.map((channel) => (
          <a
            href={channel.href}
            {...(channel.label === 'WhatsApp'
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
            class="surface group flex flex-col gap-3 p-5 transition-all duration-200
                   hover:-translate-y-0.5 hover:border-[var(--color-primary)]"
          >
            <span
              class="grid size-11 place-items-center rounded-xl
                     border border-[var(--color-primary)]/25 bg-[var(--color-primary)]/10"
              aria-hidden="true"
            >
              <svg
                class="size-[22px] text-[var(--color-primary)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={channel.icon} />
              </svg>
            </span>

            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-[var(--text-subtle)]">
                {channel.label}
              </p>
              <p class="mt-1 break-words font-semibold text-[var(--text)] transition-colors group-hover:text-[var(--color-primary)]">
                {channel.value}
              </p>
              <p class="mt-1.5 text-sm text-[var(--text-muted)]">{channel.note}</p>
            </div>
          </a>
        ))
      }
    </div>

    {/* ---------- Details ---------- */}
    <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="prose">
        <h2>Editorial</h2>
        <p>
          For corrections, factual disputes, story tips or article pitches, email
          <a href={`mailto:${org.email}`}>{org.email}</a>. We read everything and reply to
          anything that needs a reply.
        </p>
        <p>
          If you are reporting an error in a published article, include the article URL and
          the specific claim you are disputing. Corrections that change the substance of a
          piece are noted on the article itself, per our
          <a href="/editorial-policy/">editorial policy</a>.
        </p>

        <h2>Security disclosures</h2>
        <p>
          To report a vulnerability in this website, email
          <a href={`mailto:${org.email}`}>{org.email}</a> with a subject line beginning
          <code>SECURITY</code>. Include reproduction steps and give us a reasonable window
          to remediate before publishing.
        </p>
        <p>
          We do not operate a paid bug bounty. We will credit reporters who ask to be
          credited.
        </p>

        <h2>Press and speaking</h2>
        <p>
          For interview requests, expert commentary or conference enquiries, use the same
          address and include your deadline so we can prioritise appropriately.
        </p>

        <h2>What we do not accept</h2>
        <ul>
          <li>Paid guest posts, sponsored articles or link insertions.</li>
          <li>Requests to remove or amend accurate published reporting.</li>
          <li>Unsolicited AI-generated article submissions.</li>
        </ul>
        <p>
          The reasoning behind these is set out in the
          <a href="/editorial-policy/">editorial policy</a>.
        </p>
      </div>

      {/* ---------- Sidebar ---------- */}
      <aside class="space-y-5">
        <div class="surface p-5">
          <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text)]">
            Office
          </h2>
          <address class="mt-3 text-sm not-italic leading-relaxed text-[var(--text-muted)]">
            <strong class="block font-semibold text-[var(--text)]">{org.legalName}</strong>
            {org.address.locality}<br />
            {org.address.country}
          </address>
        </div>

        <div class="surface p-5">
          <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text)]">
            Business hours
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">
            {org.hours}
          </p>
          <p class="mt-2 text-sm text-[var(--text-subtle)]">{org.responseTime}.</p>
        </div>

        <div class="surface p-5">
          <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--text)]">
            Elsewhere
          </h2>
          <ul class="mt-3 space-y-2 text-sm">
            {
              SITE.social.linkedin && (
                <li>
                  <a
                    href={SITE.social.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text-muted)] transition-colors hover:text-[var(--color-primary)]"
                  >
                    LinkedIn
                  </a>
                </li>
              )
            }
            {
              SITE.social.instagram && (
                <li>
                  <a
                    href={SITE.social.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[var(--text-muted)] transition-colors hover:text-[var(--color-primary)]"
                  >
                    Instagram
                  </a>
                </li>
              )
            }
            <li>
              <a
                href="/rss.xml"
                class="text-[var(--text-muted)] transition-colors hover:text-[var(--color-primary)]"
              >
                RSS feed
              </a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
