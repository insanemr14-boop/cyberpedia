---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SearchBar from '../components/SearchBar.astro';
import { getPublishedArticles } from '../lib/articles';
import { SITE } from '../config/site.config';

// A 404 that offers real routes recovers the visit instead of ending it.
const recent = (await getPublishedArticles()).slice(0, 3);
---

<BaseLayout
  title="Page Not Found"
  description="That page does not exist. Search the archive or browse the latest security analysis and guides."
  noindex
>
  <div class="container-page py-16 sm:py-24">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-6xl font-extrabold tracking-tight text-[var(--color-primary)] sm:text-7xl">
        404
      </p>
      <h1 class="mt-4 text-2xl font-extrabold tracking-tight text-[var(--text)] sm:text-3xl">
        We could not find that page
      </h1>
      <p class="mt-3 text-[var(--text-muted)]">
        The URL may have changed, or the page may never have existed. Search the archive
        or start from one of the sections below.
      </p>

      <div class="mt-7">
        <SearchBar variant="page" />
      </div>

      <nav class="mt-6 flex flex-wrap justify-center gap-2" aria-label="Recovery links">
        {
          [
            { label: 'Home', href: '/' },
            { label: 'Latest News', href: '/news' },
            { label: 'Guides', href: '/guides' },
            { label: 'Reviews', href: '/reviews' },
            { label: 'All Categories', href: '/categories' },
          ].map((link) => (
            <a
              href={link.href}
              class="rounded-lg border border-[var(--border)] px-4 py-2 text-sm font-medium
                     text-[var(--text-muted)] transition-colors
                     hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    {
      recent.length > 0 && (
        <section class="mt-16" aria-labelledby="notfound-recent">
          <h2
            id="notfound-recent"
            class="mb-5 text-center text-xs font-bold uppercase tracking-wider text-[var(--text-subtle)]"
          >
            Latest from {SITE.name}
          </h2>
          <div class="grid gap-5 sm:grid-cols-3">
            {recent.map((article) => (
              <ArticleCard article={article} variant="default" headingLevel={3} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
